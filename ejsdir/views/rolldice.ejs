<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roll Dice</title>
</head>
<body>
    <h1>DICE VALUE= <%= num %></h1>
    <% if(num==6) { %>
    <h2>MAXIMUM! Roll it again.</h2>
    <% } %>
    <% if(num==1) { %>
    <h2>MINIMUM! Better luck next time.</h2>
    <% } %>
</body>
</html>