<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatApp</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <h3>ChatApp</h3>
    <% for(let c of chats){ %>
        <div class="box">
            <h4>from: <%= c.from %></h4>
            <div class="msg">
                <%= c.message %>
            </div>
            <h4>to: <%= c.to %></h4>
        </div>
        <hr>
    <%}%>

</body>
</html>

    
