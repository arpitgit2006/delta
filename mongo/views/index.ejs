<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatApp</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <h2>ChatApp</h2>
    <% for(let c of chats){ %>
        <div class="box">
            <h4>from: <%= c.from %></h4>
            <div class="msg">
                <h3><%= c.message %></h3>
            </div>
            <h4>to: <%= c.to %></h4>
        </div>
    <%}%>
    <form method="get" action="/chats/new">
        <button>enter chat</button>
    </form>

</body>
</html>

    
