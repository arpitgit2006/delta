<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form method="post" action="/posts/<%= post.username %>?_method=PATCH"> 
        <h1>Edit your post</h1>
        <h2><%= post.username %></h2>
        <textarea name="content" placeholder="enter content" id="content"><%= post.content %></textarea><br><br><br>
        <button>Submit</button>
    </form>
</body>
</html>