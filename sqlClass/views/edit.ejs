<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h2>you are editing this user: <%= user.id %></h2>
    <form method="post" action="/user/<%=user.id%>?_method=PATCH">
        <h3>Enter password to edit :  </h3>
        <textarea name="password"></textarea><br><br>
        <h3>Username:  </h3>
        <textarea name="username" ><%= user.username %></textarea><br><br>
        <h3>Email:  </h3>
        <textarea name="email" ><%= user.email%></textarea><br><br>
        <button>Submit</button>
    </form>
</body>
</html>